{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "structural-diagram",
    "title": "Structural Diagram IR",
    "description": "Schema for Class and Object diagrams",
    "type": "object",
    "required": [
        "diagramType",
        "elements",
        "relationships"
    ],
    "properties": {
        "diagramType": {
            "type": "string",
            "enum": [
                "class",
                "object"
            ]
        },
        "title": {
            "type": "string"
        },
        "elements": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/classElement"
            }
        },
        "relationships": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/relationship"
            }
        }
    },
    "definitions": {
        "visibility": {
            "type": "string",
            "enum": [
                "+",
                "-",
                "#",
                "~"
            ]
        },
        "attribute": {
            "type": "object",
            "required": [
                "name",
                "type",
                "visibility"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "type": {
                    "type": "string",
                    "minLength": 1
                },
                "visibility": {
                    "$ref": "#/definitions/visibility"
                },
                "isStatic": {
                    "type": "boolean"
                },
                "defaultValue": {
                    "type": "string"
                }
            }
        },
        "parameter": {
            "type": "object",
            "required": [
                "name",
                "type"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "type": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "method": {
            "type": "object",
            "required": [
                "name",
                "parameters",
                "returnType",
                "visibility"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "parameters": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/parameter"
                    }
                },
                "returnType": {
                    "type": "string"
                },
                "visibility": {
                    "$ref": "#/definitions/visibility"
                },
                "isStatic": {
                    "type": "boolean"
                },
                "isAbstract": {
                    "type": "boolean"
                }
            }
        },
        "classElement": {
            "type": "object",
            "required": [
                "type",
                "name",
                "attributes",
                "methods"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "class",
                        "interface",
                        "abstract",
                        "enum"
                    ]
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "stereotype": {
                    "type": "string"
                },
                "attributes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/attribute"
                    }
                },
                "methods": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/method"
                    }
                },
                "enumValues": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "if": {
                "properties": {
                    "type": {
                        "const": "interface"
                    }
                }
            },
            "then": {
                "properties": {
                    "attributes": {
                        "items": {
                            "properties": {
                                "isStatic": {
                                    "const": true
                                }
                            }
                        }
                    }
                }
            }
        },
        "multiplicity": {
            "type": "object",
            "required": [
                "from",
                "to"
            ],
            "properties": {
                "from": {
                    "type": "string"
                },
                "to": {
                    "type": "string"
                }
            }
        },
        "relationship": {
            "type": "object",
            "required": [
                "type",
                "from",
                "to"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "association",
                        "aggregation",
                        "composition",
                        "inheritance",
                        "realization",
                        "dependency"
                    ]
                },
                "from": {
                    "type": "string",
                    "minLength": 1
                },
                "to": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "string"
                },
                "multiplicity": {
                    "$ref": "#/definitions/multiplicity"
                },
                "fromRole": {
                    "type": "string"
                },
                "toRole": {
                    "type": "string"
                }
            }
        }
    }
}