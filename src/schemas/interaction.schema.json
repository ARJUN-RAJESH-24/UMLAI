{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "interaction-diagram",
    "title": "Interaction Diagram IR",
    "description": "Schema for Sequence and Communication diagrams",
    "type": "object",
    "required": [
        "diagramType",
        "participants",
        "messages"
    ],
    "properties": {
        "diagramType": {
            "type": "string",
            "enum": [
                "sequence",
                "communication"
            ]
        },
        "title": {
            "type": "string"
        },
        "participants": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/participant"
            },
            "minItems": 1
        },
        "messages": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/message"
            }
        },
        "fragments": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/combinedFragment"
            }
        }
    },
    "definitions": {
        "participant": {
            "type": "object",
            "required": [
                "name",
                "type"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "alias": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "actor",
                        "participant",
                        "boundary",
                        "control",
                        "entity",
                        "database"
                    ]
                }
            }
        },
        "message": {
            "type": "object",
            "required": [
                "from",
                "to",
                "label",
                "type"
            ],
            "properties": {
                "from": {
                    "type": "string",
                    "minLength": 1
                },
                "to": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "sync",
                        "async",
                        "return",
                        "create",
                        "destroy"
                    ]
                },
                "number": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "combinedFragment": {
            "type": "object",
            "required": [
                "type",
                "messages"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "alt",
                        "opt",
                        "loop",
                        "break",
                        "par",
                        "critical"
                    ]
                },
                "condition": {
                    "type": "string"
                },
                "messages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/message"
                    }
                },
                "elseMessages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/message"
                    }
                }
            }
        }
    }
}