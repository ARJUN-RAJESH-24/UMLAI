{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "architecture-diagram",
    "title": "Architecture Diagram IR",
    "description": "Schema for Component, Deployment, and Package diagrams",
    "oneOf": [
        {
            "$ref": "#/definitions/componentDiagram"
        },
        {
            "$ref": "#/definitions/deploymentDiagram"
        },
        {
            "$ref": "#/definitions/packageDiagram"
        }
    ],
    "definitions": {
        "componentDiagram": {
            "type": "object",
            "required": [
                "diagramType",
                "components",
                "interfaces",
                "relationships"
            ],
            "properties": {
                "diagramType": {
                    "const": "component"
                },
                "title": {
                    "type": "string"
                },
                "components": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/component"
                    }
                },
                "interfaces": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/interface"
                    }
                },
                "relationships": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/componentRelationship"
                    }
                }
            }
        },
        "component": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "stereotype": {
                    "type": "string"
                },
                "provides": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "requires": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "interface": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "componentRelationship": {
            "type": "object",
            "required": [
                "type",
                "from",
                "to"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "dependency",
                        "realization",
                        "uses"
                    ]
                },
                "from": {
                    "type": "string",
                    "minLength": 1
                },
                "to": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "string"
                }
            }
        },
        "deploymentDiagram": {
            "type": "object",
            "required": [
                "diagramType",
                "nodes",
                "artifacts",
                "communicationPaths"
            ],
            "properties": {
                "diagramType": {
                    "const": "deployment"
                },
                "title": {
                    "type": "string"
                },
                "nodes": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/deploymentNode"
                    }
                },
                "artifacts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "communicationPaths": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/communicationPath"
                    }
                }
            }
        },
        "deploymentNode": {
            "type": "object",
            "required": [
                "name",
                "type"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "node",
                        "device",
                        "executionEnvironment"
                    ]
                },
                "stereotype": {
                    "type": "string"
                },
                "deployedArtifacts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "communicationPath": {
            "type": "object",
            "required": [
                "from",
                "to"
            ],
            "properties": {
                "from": {
                    "type": "string",
                    "minLength": 1
                },
                "to": {
                    "type": "string",
                    "minLength": 1
                },
                "protocol": {
                    "type": "string"
                }
            }
        },
        "packageDiagram": {
            "type": "object",
            "required": [
                "diagramType",
                "packages",
                "dependencies"
            ],
            "properties": {
                "diagramType": {
                    "const": "package"
                },
                "title": {
                    "type": "string"
                },
                "packages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/package"
                    }
                },
                "dependencies": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/packageDependency"
                    }
                }
            }
        },
        "package": {
            "type": "object",
            "required": [
                "name",
                "elements"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "elements": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "subpackages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/package"
                    }
                }
            }
        },
        "packageDependency": {
            "type": "object",
            "required": [
                "from",
                "to"
            ],
            "properties": {
                "from": {
                    "type": "string",
                    "minLength": 1
                },
                "to": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}